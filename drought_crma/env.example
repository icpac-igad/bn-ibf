# Copy this file to `.env` and fill in real values.
# `.env` is loaded by download_seas51_tp_to_icechunk.py via python-dotenv.

# ---------------------------------------------------------------------------
# ECMWF CDS API credentials
# Get them at: https://cds.climate.copernicus.eu/how-to-api
# (cdsapi.Client() reads CDSAPI_URL / CDSAPI_KEY from the environment when
# ~/.cdsapirc is absent, so we just export them from .env.)
# ---------------------------------------------------------------------------
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=<your-cds-api-key>

# ---------------------------------------------------------------------------
# source.coop S3 target.
# source.coop publishes data through a real AWS S3 bucket
# (us-west-2.opendata.source.coop), with each repo as a key prefix:
#   s3://us-west-2.opendata.source.coop/<account>/<repo>/<store>/...
# Use the standard AWS S3 endpoint — DO NOT set endpoint_url.
# ---------------------------------------------------------------------------
SOURCE_COOP_BUCKET=us-west-2.opendata.source.coop
SOURCE_COOP_PREFIX=e4drr-project/forecasts/seas51_tp_icechunk
SOURCE_COOP_REGION=us-west-2

# ---------------------------------------------------------------------------
# source.coop S3 credentials.
# Generate WRITE-scoped keys in the source.coop UI:
#   https://source.coop/repositories/e4drr-project/forecasts/manage
# (source.coop hands them out in this AWS_* format with `export ` prefix —
# python-dotenv strips the `export ` automatically.)
# ---------------------------------------------------------------------------
export AWS_ACCESS_KEY_ID="<your-access-key-id>"
export AWS_SECRET_ACCESS_KEY="<your-secret-access-key>"
export AWS_SESSION_TOKEN="<your-session-token-if-temporary>"
export AWS_DEFAULT_REGION="us-west-2"
